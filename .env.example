# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:5000

# API (apps/api)
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=taslim;Username=taslim;Password=change-me
AllowedOrigins__0=http://localhost:3000

# API file storage (server-side only; Production uses S3Compatible for Cloudflare R2)
Files__StorageProvider=Local
Files__S3Endpoint=
Files__S3Region=auto
Files__S3Bucket=
Files__S3AccessKey=
Files__S3SecretKey=

# Movie video generation remains disabled until a vetted provider is explicitly enabled.
# Provider credentials belong only on the API service; never add them to frontend configuration.
Files__MaxGeneratedVideoBytes=262144000
MovieVideo__Enabled=false
MovieVideo__ProviderKey=unconfigured
MovieVideo__ApiBaseUrl=https://api.dev.runwayml.com/v1/
MovieVideo__ApiKey=
MovieVideo__Model=gen4.5
MovieVideo__ProviderTimeoutSeconds=30
MovieVideo__CreditUsd=0.01
MovieVideo__StatusPollIntervalSeconds=5
MovieVideo__MaxStatusPolls=120
MovieVideo__MaxTransientRetries=3
MovieVideo__RetryBaseDelaySeconds=2
MovieVideo__RetryMaxDelaySeconds=30
MovieVideo__Manus__Enabled=false
MovieVideo__Manus__ApiBaseUrl=https://api.manus.ai/
MovieVideo__Manus__ApiKey=
MovieVideo__Manus__AgentProfile=standard
MovieVideo__Manus__CreditUsdPerCredit=
MovieVideo__Manus__MaxPromptCharacters=12000
MovieVideo__Manus__MaxTaskMessages=50

# Music provider adapters remain disabled by default; never commit a provider key.
MusicGeneration__Enabled=false
MusicGeneration__ProviderKey=mubert
MusicGeneration__StableAudioApiKey=
MusicGeneration__StableAudioModel=stable-audio-3
MusicGeneration__StableAudioOutputFormat=mp3
