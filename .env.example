# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:5000

# API (apps/api)
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=taslim;Username=taslim;Password=change-me
AllowedOrigins__0=http://localhost:3000

# API file storage (server-side only; Production uses S3Compatible for Cloudflare R2)
Files__StorageProvider=Local
Files__S3Endpoint=
Files__S3Region=auto
Files__S3Bucket=
Files__S3AccessKey=
Files__S3SecretKey=

# Movie video generation remains unavailable until a vetted provider adapter is registered.
# Provider credentials, if later required by an adapter, belong only on the API service.
Files__MaxGeneratedVideoBytes=262144000
MovieVideo__Enabled=false
MovieVideo__ProviderKey=unconfigured
MovieVideo__ApiBaseUrl=https://api.dev.runwayml.com/v1/
MovieVideo__ApiKey=
MovieVideo__Model=gen4.5
MovieVideo__ProviderTimeoutSeconds=30
MovieVideo__CreditUsd=0.01
MovieVideo__StatusPollIntervalSeconds=5
MovieVideo__MaxStatusPolls=120
MovieVideo__MaxTransientRetries=3
MovieVideo__RetryBaseDelaySeconds=2
MovieVideo__RetryMaxDelaySeconds=30
