        "CostTier": "low",
        "CapabilityTier": "Fast"
      },
      "gpt-5.6-terra": {
        "ProviderKey": "openai",
        "DisplayName": "Taslim Smart",
        "Enabled": true,
        "SupportsStreaming": true,
        "SupportsVision": false,
        "SupportsTools": false,
        "ContextWindow": 128000,
