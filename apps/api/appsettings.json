        "CostTier": "standard",
        "CapabilityTier": "Smart"
      },
      "gpt-5.6-sol": {
        "ProviderKey": "openai",
        "DisplayName": "Taslim Advanced",
        "Enabled": true,
        "SupportsStreaming": true,
        "SupportsVision": true,
