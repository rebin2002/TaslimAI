      "Enabled": false,
      "BaseUrl": "https://api.openai.com/v1"
    },
    "Models": {
      "gpt-5.6-luna": {
        "ProviderKey": "openai",
        "DisplayName": "Taslim Fast",
        "Enabled": true,
        "SupportsStreaming": true,
