ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=taslim;Username=taslim;Password=change-me
# Railway may provide postgresql://user:password@host:port/database; the API normalizes it server-side.
AllowedOrigins__0=http://localhost:3000
Database__ApplyMigrations=false

# Batch 3.2 AI configuration (server-side only; never put these on Taslim Web)
Ai__OpenAI__Enabled=false
Ai__OpenAI__ApiKey=
Ai__OpenAI__BaseUrl=https://api.openai.com/v1
Ai__DefaultChatTier=Smart
Ai__ContextBudgetTokens=12000
Ai__ProviderTimeoutSeconds=90
