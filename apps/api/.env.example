ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=taslim;Username=taslim;Password=change-me
# Railway may provide postgresql://user:password@host:port/database; the API normalizes it server-side.
AllowedOrigins__0=http://localhost:3000
Database__ApplyMigrations=false

# Batch 3.2 AI configuration (server-side only; never put these on Taslim Web)
Ai__OpenAI__Enabled=false
Ai__OpenAI__ApiKey=
Ai__OpenAI__BaseUrl=https://api.openai.com/v1
Ai__DefaultChatTier=Smart
Ai__ContextBudgetTokens=12000
Ai__FileContextBudgetTokens=4000
Ai__ProviderTimeoutSeconds=90

# Batch 3.5 file foundation (server-side only)
Files__StorageProvider=Local
Files__LocalRootPath=App_Data/files
Files__MaxFileSizeBytes=26214400
Files__MaxAttachmentsPerMessage=5
Files__FileContextBudgetTokens=4000
Files__MaxExtractedTextCharacters=80000
# Production appsettings selects S3Compatible; provide the following when a persistent bucket is connected.
Files__S3Endpoint=
Files__S3Region=auto
Files__S3Bucket=
Files__S3AccessKey=
Files__S3SecretKey=
