{
  "Database": {
    "ApplyMigrations": true
  },
  "Files": {
    "StorageProvider": "S3Compatible",
    "S3Region": "auto",
    "MaxFileSizeBytes": 26214400,
    "MaxAttachmentsPerMessage": 5,
    "FileContextBudgetTokens": 4000,
    "MaxExtractedTextCharacters": 80000
  },
  "Ai": {
    "AllowMockProvider": false,
    "OpenAI": {
      "Enabled": false,
      "BaseUrl": "https://api.openai.com/v1"
    }
  },
  "ImageGeneration": {
    "Enabled": true,
    "ProviderKey": "openai",
    "Model": "gpt-image-2.5-sunburst",
    "ProviderTimeoutSeconds": 150,
    "MaxPromptCharacters": 4000,
    "MaxTitleCharacters": 160,
    "MaxImagesPerJob": 1,
    "MaxOutputBytes": 10485760,
    "Pricing": {
      "TextInputUsdPerMillion": 5.0,
      "CachedTextInputUsdPerMillion": 1.25,
      "ImageInputUsdPerMillion": 8.0,
      "CachedImageInputUsdPerMillion": 2.0,
      "ImageOutputUsdPerMillion": 30.0
    }
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
